{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frontier Overlay",
  "version": "0.10.1",
  "identifier": "cloud.egpr.frontieroverlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Frontier Overlay",
        "width": 1400,
        "height": 860,
        "minWidth": 520,
        "minHeight": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "backgroundColor": "#0f1513"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "nith_",
    "shortDescription": "PokeMMO Battle Frontier set lookup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
